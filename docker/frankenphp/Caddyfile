{
	skip_install_trust
	frankenphp
	{$CADDY_GLOBAL_OPTIONS}
}

http://localhost:2080 {
	bind 127.0.0.1
	root * /app/public

	@health path /up
	handle @health {
		php_server
	}

	handle {
		respond 404
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(self), microphone=(self)"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
		defer
	}
}

{$SERVER_NAME:localhost} {
	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	import security_headers

	log {
		output stderr
		format json
	}

	root * /app/public
	encode zstd br gzip

	@laravel path /api/* /sanctum/* /up
	handle @laravel {
		php_server
	}

	handle {
		root * /app/public/app

		route {
			try_files {path} /index.html

			@unversioned path /index.html /ngsw.json /manifest.webmanifest /ngsw-worker.js /safety-worker.js /worker-basic.min.js
			header @unversioned Cache-Control "no-cache"

			@fingerprinted path_regexp -[A-Za-z0-9_-]{8}\.(js|css)$
			header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

			file_server
		}
	}
}
